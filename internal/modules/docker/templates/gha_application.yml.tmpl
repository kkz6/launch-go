# Managed by Launch. Edits will be overwritten on the next sync.
name: Launch Deploy

on:
  push:
    branches: ["{{.Branch}}"]
  workflow_dispatch:

concurrency:
  group: launch-deploy-${{ "{{" }} github.ref {{ "}}" }}
  cancel-in-progress: false

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v4

      # Set up the buildx docker-container driver. The default driver
      # baked into the runner is plain `docker` which does NOT support
      # `cache-from: type=gha` / `cache-to: type=gha,mode=max` — without
      # this step the dockerfile build below dies with
      # "Cache export is not supported for the docker driver."
      - uses: docker/setup-buildx-action@v3

      - name: Compute image tag
        id: meta
        run: |
          # GHCR rejects tags with uppercase letters in the repository
          # path ("repository name must be lowercase"). github.repository
          # preserves the original case (e.g. GlobalJapan/gj-hrms-api),
          # so we lowercase explicitly via bash ${VAR,,}. The token-
          # exchange step below already uses ${GITHUB_REPOSITORY,,} for
          # the same reason — keep the two in lock-step or buildx will
          # fail with "invalid tag: repository name must be lowercase"
          # before we ever reach the registry.
          REPO_LC="${GITHUB_REPOSITORY,,}"
          echo "image=ghcr.io/${REPO_LC}:launch-${GITHUB_SHA::7}" >> $GITHUB_OUTPUT

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ "{{" }} github.actor {{ "}}" }}
          password: ${{ "{{" }} secrets.GITHUB_TOKEN {{ "}}" }}

      - name: Detect builder
        id: builder
        run: |
          if [ -f "{{.DockerfilePath}}" ]; then
            echo "kind=dockerfile" >> $GITHUB_OUTPUT
          else
            echo "kind=nixpacks"   >> $GITHUB_OUTPUT
          fi

      - name: Build (Dockerfile)
        if: steps.builder.outputs.kind == 'dockerfile'
        uses: docker/build-push-action@v6
        with:
          context: .
          file: {{.DockerfilePath}}
          push: true
          tags: ${{ "{{" }} steps.meta.outputs.image {{ "}}" }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          {{- if .BuildSecretNames}}
          # Build-time secrets — values come from per-name repo secrets
          # (LAUNCH_BUILD_<NAME>) that Launch pushes alongside this
          # workflow. Each maps to a Dockerfile reference like:
          #   RUN --mount=type=secret,id=<NAME> cat /run/secrets/<NAME>
          # Adding/removing a build secret in Launch re-syncs this
          # workflow file so the list stays current.
          secrets: |
{{- range .BuildSecretNames}}
            {{.}}=${{ "{{" }} secrets.LAUNCH_BUILD_{{.}} {{ "}}" }}
{{- end}}
          {{- end}}

      # Nixpacks via shell. The previous template used
      # iloveitaly/nixpacks-action, which no longer exists in the
      # GHA Marketplace — GitHub resolves every `uses:` reference
      # during "Set up job" before any `if:` runs, so even though
      # the Dockerfile path wins for most workloads, an unresolvable
      # action ID killed the whole job. Inline the install + build
      # script instead so the workflow only depends on actions that
      # actually exist (checkout, login-action, build-push-action).
      - name: Build (Nixpacks)
        if: steps.builder.outputs.kind == 'nixpacks'
        env:
          IMAGE: ${{ "{{" }} steps.meta.outputs.image {{ "}}" }}
        run: |
          set -euo pipefail
          curl -sSL https://nixpacks.com/install.sh | bash
          nixpacks build . --name "$IMAGE"
          docker push "$IMAGE"

      # Mint a short-lived (~1h) GHCR pull bearer scoped to THIS repo
      # via the standard token-exchange endpoint. The Launch deploy
      # worker uses this for `docker login ghcr.io` on the target host
      # so private GHCR packages pull cleanly — no Personal Access
      # Token, no public-package workaround, no GitHub App
      # installation-token quirk (App tokens can't pull private GHCR
      # packages regardless of permissions).
      #
      # ::add-mask::$bearer is critical — without it any future
      # step that echoes the bearer would expose it in the workflow
      # log. With it, GitHub redacts the literal string in all
      # subsequent log output.
      - name: Mint GHCR pull token
        id: ghcr_token
        env:
          GITHUB_TOKEN: ${{ "{{" }} secrets.GITHUB_TOKEN {{ "}}" }}
        run: |
          set -euo pipefail
          # GHCR's /token endpoint uses Docker Registry v2 Basic auth,
          # NOT Bearer — the username can be any non-empty placeholder
          # (we use github.actor for symmetry with the docker login
          # step above), password is the workflow's GITHUB_TOKEN. The
          # response is a fresh ~1h JWT scoped to repository:<owner>/
          # <repo>:pull, suitable for `docker login` as the password
          # on the deploy host. Repo name lowercased — GHCR requires
          # it even when the GitHub repo name has uppercase letters.
          bearer=$(curl -fsSL \
            -u "${GITHUB_ACTOR}:${GITHUB_TOKEN}" \
            "https://ghcr.io/token?service=ghcr.io&scope=repository:${GITHUB_REPOSITORY,,}:pull" \
            | jq -r '.token // empty')
          if [ -z "$bearer" ]; then
            echo "::error::Failed to mint GHCR pull token"
            exit 1
          fi
          echo "::add-mask::$bearer"
          {
            echo "bearer<<LAUNCH_BEARER_EOF"
            echo "$bearer"
            echo "LAUNCH_BEARER_EOF"
          } >> "$GITHUB_OUTPUT"
          echo "minted_at=$(date -u +%s)" >> "$GITHUB_OUTPUT"

      - name: Notify Launch (success)
        env:
          TOKEN: ${{ "{{" }} secrets.LAUNCH_DEPLOY_TOKEN {{ "}}" }}
          # Pass the bearer through an env var so jq's --arg gets it
          # verbatim — inlining via `${{ "{{" }} steps.* {{ "}}" }}`
          # in jq args invites shell-quote escapes on edge cases.
          GHCR_BEARER: ${{ "{{" }} steps.ghcr_token.outputs.bearer {{ "}}" }}
          GHCR_BEARER_MINTED_AT: ${{ "{{" }} steps.ghcr_token.outputs.minted_at {{ "}}" }}
        run: |
          curl --fail-with-body -sS -X POST \
            -H "Authorization: Bearer $TOKEN" \
            -H "Content-Type: application/json" \
            -d "$(jq -nc \
              --arg image     '${{ "{{" }} steps.meta.outputs.image {{ "}}" }}' \
              --arg sha       '${{ "{{" }} github.sha {{ "}}" }}' \
              --arg branch    '${{ "{{" }} github.ref_name {{ "}}" }}' \
              --arg run_id    '${{ "{{" }} github.run_id {{ "}}" }}' \
              --arg url       '${{ "{{" }} github.server_url {{ "}}" }}/${{ "{{" }} github.repository {{ "}}" }}/actions/runs/${{ "{{" }} github.run_id {{ "}}" }}' \
              --arg pull      "$GHCR_BEARER" \
              --arg minted_at "$GHCR_BEARER_MINTED_AT" \
              '{image_tag:$image, commit_sha:$sha, branch:$branch, run_id:$run_id, run_url:$url, ghcr_pull_token:$pull, ghcr_pull_token_minted_at:$minted_at}')" \
            "${{ "{{" }} vars.LAUNCH_WEBHOOK_URL {{ "}}" }}/api/webhooks/docker/applications/{{.AppID}}/deploy"

      - name: Notify Launch (failure)
        if: failure()
        env:
          TOKEN: ${{ "{{" }} secrets.LAUNCH_DEPLOY_TOKEN {{ "}}" }}
        run: |
          curl -sS -X POST \
            -H "Authorization: Bearer $TOKEN" \
            -H "Content-Type: application/json" \
            -d "$(jq -nc \
              --arg run_id '${{ "{{" }} github.run_id {{ "}}" }}' \
              --arg url    '${{ "{{" }} github.server_url {{ "}}" }}/${{ "{{" }} github.repository {{ "}}" }}/actions/runs/${{ "{{" }} github.run_id {{ "}}" }}' \
              '{status:"failed", run_id:$run_id, run_url:$url}')" \
            "${{ "{{" }} vars.LAUNCH_WEBHOOK_URL {{ "}}" }}/api/webhooks/docker/applications/{{.AppID}}/status"
