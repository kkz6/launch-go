# Managed by Launch. Edits will be overwritten on the next sync.
name: Launch Deploy

on:
{{- if .AutoDeploy }}
  push:
    branches: [{{ .Branch }}]
{{- end }}
  workflow_dispatch:

concurrency:
  group: launch-deploy-${{ "{{" }} github.ref {{ "}}" }}
  cancel-in-progress: false

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v4
{{- if ne .Platform "linux/amd64" }}

      - uses: docker/setup-qemu-action@v3
{{- end }}

      - uses: docker/setup-buildx-action@v3

      - name: Compute image tag
        id: meta
        run: |
          echo "image=ghcr.io/{{.ImagePackage}}:launch-${GITHUB_SHA::7}" >> $GITHUB_OUTPUT

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ "{{" }} github.actor {{ "}}" }}
          password: ${{ "{{" }} secrets.GITHUB_TOKEN {{ "}}" }}

      - name: Detect builder
        id: builder
        run: |
          case "{{.BuildType}}" in
            dockerfile)
              if [ ! -f "{{.DockerfilePath}}" ]; then
                echo "::error::Build method is 'dockerfile' but {{.DockerfilePath}} was not found in the repo. Add the Dockerfile, or switch the build method to Nixpacks in Launch."
                exit 1
              fi
              echo "kind=dockerfile" >> $GITHUB_OUTPUT ;;
            nixpacks)
              echo "kind=nixpacks" >> $GITHUB_OUTPUT ;;
            *)
              if [ -f "{{.DockerfilePath}}" ]; then
                echo "kind=dockerfile" >> $GITHUB_OUTPUT
              else
                echo "kind=nixpacks" >> $GITHUB_OUTPUT
              fi ;;
          esac

      - name: Build (Dockerfile)
        if: steps.builder.outputs.kind == 'dockerfile'
        uses: docker/build-push-action@v6
        with:
          context: .
          file: {{.DockerfilePath}}
          push: true
          platforms: {{.Platform}}
          tags: ${{ "{{" }} steps.meta.outputs.image {{ "}}" }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          {{- if .BuildSecretNames}}
          secrets: |
{{- range .BuildSecretNames}}
            {{.}}=${{ "{{" }} secrets.LAUNCH_BUILD_{{.}} {{ "}}" }}
{{- end}}
          {{- end}}

      - name: Build (Nixpacks)
        if: steps.builder.outputs.kind == 'nixpacks'
        env:
          IMAGE: ${{ "{{" }} steps.meta.outputs.image {{ "}}" }}
        run: |
          set -euo pipefail
          curl -sSL https://nixpacks.com/install.sh | bash
          nixpacks build . --name "$IMAGE"
          docker push "$IMAGE"

      - name: Mint GHCR pull token
        id: ghcr_token
        env:
          GITHUB_TOKEN: ${{ "{{" }} secrets.GITHUB_TOKEN {{ "}}" }}
        run: |
          set -euo pipefail
          bearer=$(curl -fsSL \
            -u "${GITHUB_ACTOR}:${GITHUB_TOKEN}" \
            "https://ghcr.io/token?service=ghcr.io&scope=repository:{{.ImagePackage}}:pull" \
            | jq -r '.token // empty')
          if [ -z "$bearer" ]; then
            echo "::error::Failed to mint GHCR pull token"
            exit 1
          fi
          echo "::add-mask::$bearer"
          {
            echo "bearer<<LAUNCH_BEARER_EOF"
            echo "$bearer"
            echo "LAUNCH_BEARER_EOF"
          } >> "$GITHUB_OUTPUT"
          echo "minted_at=$(date -u +%s)" >> "$GITHUB_OUTPUT"

      - name: Notify Launch (success)
        id: notify
        env:
          TOKEN: ${{ "{{" }} secrets.{{.DeployTokenSecret}} {{ "}}" }}
          GHCR_BEARER: ${{ "{{" }} steps.ghcr_token.outputs.bearer {{ "}}" }}
          GHCR_BEARER_MINTED_AT: ${{ "{{" }} steps.ghcr_token.outputs.minted_at {{ "}}" }}
        run: |
          resp=$(curl --fail-with-body -sS --connect-timeout 10 --max-time 30 -X POST \
            -H "Authorization: Bearer $TOKEN" \
            -H "Content-Type: application/json" \
            -d "$(jq -nc \
              --arg image     '${{ "{{" }} steps.meta.outputs.image {{ "}}" }}' \
              --arg sha       '${{ "{{" }} github.sha {{ "}}" }}' \
              --arg branch    '${{ "{{" }} github.ref_name {{ "}}" }}' \
              --arg run_id    '${{ "{{" }} github.run_id {{ "}}" }}' \
              --arg url       '${{ "{{" }} github.server_url {{ "}}" }}/${{ "{{" }} github.repository {{ "}}" }}/actions/runs/${{ "{{" }} github.run_id {{ "}}" }}' \
              --arg pull      "$GHCR_BEARER" \
              --arg minted_at "$GHCR_BEARER_MINTED_AT" \
              '{image_tag:$image, commit_sha:$sha, branch:$branch, run_id:$run_id, run_url:$url, ghcr_pull_token:$pull, ghcr_pull_token_minted_at:$minted_at}')" \
            "${{ "{{" }} vars.LAUNCH_WEBHOOK_URL {{ "}}" }}/api/webhooks/docker/applications/{{.AppID}}/deploy") \
            || { echo "::error::Launch rejected the deploy notify"; echo "$resp"; exit 1; }
          echo "$resp"
          deployment_id=$(printf '%s' "$resp" | jq -r '.data.deployment_id // empty')
          if [ -z "$deployment_id" ]; then
            echo "::error::Launch accepted the notify but returned no deployment_id; cannot wait for completion"
            exit 1
          fi
          echo "deployment_id=$deployment_id" >> "$GITHUB_OUTPUT"

      - name: Wait for Launch deploy to finish
        timeout-minutes: 22
        env:
          TOKEN: ${{ "{{" }} secrets.{{.DeployTokenSecret}} {{ "}}" }}
          DEPLOYMENT_ID: ${{ "{{" }} steps.notify.outputs.deployment_id {{ "}}" }}
        run: |
          set -uo pipefail
          url="${{ "{{" }} vars.LAUNCH_WEBHOOK_URL {{ "}}" }}/api/webhooks/docker/applications/{{.AppID}}/deployments/${DEPLOYMENT_ID}"
          deadline=$(( $(date +%s) + 1200 ))
          fails=0
          max_fails=10
          while :; do
            resp=$(curl -sS --connect-timeout 10 --max-time 20 -w $'\n%{http_code}' \
              -H "Authorization: Bearer $TOKEN" "$url" || true)
            http=$(printf '%s' "$resp" | tail -n1); http=${http:-000}
            body=$(printf '%s' "$resp" | sed '$d')
            if [ "$http" = "200" ]; then
              fails=0
              status=$(printf '%s' "$body" | jq -r '.data.status // empty' 2>/dev/null || true)
              echo "deploy status: ${status:-<pending>}"
              case "$status" in
                success)
                  echo "Launch deploy succeeded."
                  exit 0 ;;
                failed|cancelled|timeout)
                  echo "::error::Launch deploy ${status}"
                  printf '%s' "$body" | jq -r '.data.error // empty' 2>/dev/null || true
                  exit 1 ;;
              esac
            else
              fails=$(( fails + 1 ))
              echo "::warning::deploy status check failed (HTTP ${http}, ${fails}/${max_fails})"
              if [ "$fails" -ge "$max_fails" ]; then
                echo "::error::Launch status endpoint unreachable/erroring — aborting so this run doesn't hang."
                exit 1
              fi
            fi
            if [ "$(date +%s)" -ge "$deadline" ]; then
              echo "::error::Timed out waiting for Launch deploy to finish"
              exit 1
            fi
            sleep 5
          done

      - name: Notify Launch (failure)
        if: failure()
        timeout-minutes: 2
        env:
          TOKEN: ${{ "{{" }} secrets.{{.DeployTokenSecret}} {{ "}}" }}
        run: |
          curl -sS --connect-timeout 10 --max-time 30 -X POST \
            -H "Authorization: Bearer $TOKEN" \
            -H "Content-Type: application/json" \
            -d "$(jq -nc \
              --arg run_id '${{ "{{" }} github.run_id {{ "}}" }}' \
              --arg url    '${{ "{{" }} github.server_url {{ "}}" }}/${{ "{{" }} github.repository {{ "}}" }}/actions/runs/${{ "{{" }} github.run_id {{ "}}" }}' \
              '{status:"failed", run_id:$run_id, run_url:$url}')" \
            "${{ "{{" }} vars.LAUNCH_WEBHOOK_URL {{ "}}" }}/api/webhooks/docker/applications/{{.AppID}}/status" || true
