#!/bin/bash
# Pre-commit hook for Launch Go
# Runs goimports, revive, and staticcheck on staged Go files

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get Go bin path
GOBIN="$(go env GOPATH)/bin"

# Tool paths (use GOPATH/bin to avoid PATH issues)
GOIMPORTS="$GOBIN/goimports"
REVIVE="$GOBIN/revive"
STATICCHECK="$GOBIN/staticcheck"

# Get the list of staged Go files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    echo -e "${GREEN}No Go files staged for commit${NC}"
    exit 0
fi

echo -e "${YELLOW}Running pre-commit checks on staged Go files...${NC}"
echo ""

# Check if required tools are installed
check_tool() {
    if [ ! -x "$1" ]; then
        echo -e "${RED}Error: $1 is not installed${NC}"
        echo "Run 'make lint-install' to install required tools"
        exit 1
    fi
}

check_tool "$GOIMPORTS"
check_tool "$REVIVE"
check_tool "$STATICCHECK"

# Track if any check fails
FAILED=0

# Run goimports and auto-fix
echo -e "${YELLOW}[1/3] Running goimports...${NC}"
for file in $STAGED_GO_FILES; do
    if [ -f "$file" ]; then
        # Run goimports and capture output
        OUTPUT=$("$GOIMPORTS" -l -w "$file" 2>&1)
        if [ -n "$OUTPUT" ]; then
            echo -e "${GREEN}  Fixed imports in: $file${NC}"
            # Re-add the file since it was modified
            git add "$file"
        fi
    fi
done
echo -e "${GREEN}  goimports complete${NC}"
echo ""

# Run revive on staged files
echo -e "${YELLOW}[2/3] Running revive...${NC}"
REVIVE_OUTPUT=""
for file in $STAGED_GO_FILES; do
    if [ -f "$file" ]; then
        FILE_OUTPUT=$("$REVIVE" -config revive.toml "$file" 2>&1 || true)
        if [ -n "$FILE_OUTPUT" ]; then
            REVIVE_OUTPUT="${REVIVE_OUTPUT}${FILE_OUTPUT}\n"
        fi
    fi
done

if [ -n "$REVIVE_OUTPUT" ]; then
    echo -e "${RED}  revive found issues:${NC}"
    echo -e "$REVIVE_OUTPUT"
    FAILED=1
else
    echo -e "${GREEN}  revive passed${NC}"
fi
echo ""

# Run staticcheck on the packages containing staged files
echo -e "${YELLOW}[3/3] Running staticcheck...${NC}"
PACKAGES=$(echo "$STAGED_GO_FILES" | xargs -n1 dirname | sort -u | sed 's/^/.\//' | tr '\n' ' ')
if [ -n "$PACKAGES" ]; then
    STATICCHECK_OUTPUT=$("$STATICCHECK" $PACKAGES 2>&1 || true)
    if [ -n "$STATICCHECK_OUTPUT" ]; then
        # Filter to only show issues in staged files
        FILTERED_OUTPUT=""
        for file in $STAGED_GO_FILES; do
            FILE_ISSUES=$(echo "$STATICCHECK_OUTPUT" | grep "^$file:" || true)
            if [ -n "$FILE_ISSUES" ]; then
                FILTERED_OUTPUT="${FILTERED_OUTPUT}${FILE_ISSUES}\n"
            fi
        done

        if [ -n "$FILTERED_OUTPUT" ]; then
            echo -e "${RED}  staticcheck found issues:${NC}"
            echo -e "$FILTERED_OUTPUT"
            FAILED=1
        else
            echo -e "${GREEN}  staticcheck passed${NC}"
        fi
    else
        echo -e "${GREEN}  staticcheck passed${NC}"
    fi
fi
echo ""

# Final result
if [ $FAILED -eq 1 ]; then
    echo -e "${RED}Pre-commit checks failed!${NC}"
    echo -e "${YELLOW}Fix the issues above before committing.${NC}"
    echo ""
    echo "To bypass this check (not recommended), use: git commit --no-verify"
    exit 1
fi

echo -e "${GREEN}All pre-commit checks passed!${NC}"
exit 0
