# Application
APP_NAME=launchctl
APP_ENV=development
APP_PORT=8000
APP_DEBUG=true
# APP_URL is the API's self-reference (signed webhook callbacks, internal
# links). APP_FRONTEND_URL is what users see — emails, billing redirects.
# In prod they're api.launchctl.io and launchctl.io respectively.
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:3000
APP_KEY=

# Database
# Option 1: Use a connection URL (takes priority over individual fields)
# DB_URL=postgres://root:password@localhost:5432/launch_go?sslmode=disable
# Option 2: Individual fields
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=launch_go
DB_USERNAME=root
DB_PASSWORD=
DB_SSLMODE=disable

# Redis (for queues)
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=72

# CORS — Nuxt dev runs on :3000 and calls the API cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Queue
QUEUE_CONCURRENCY=10

# SSH (used by the deployment-platform jobs when SSHing into managed servers)
SSH_KEY_PATH=~/.ssh
SSH_DEFAULT_USER=root

# Passkey / WebAuthn relying-party config. For local dev these stay on
# localhost; production uses the bare domain.
PASSKEY_RP_NAME=Launch
PASSKEY_RP_ID=localhost
PASSKEY_RP_ORIGIN=http://localhost:3000

# Storage (S3)
STORAGE_DRIVER=s3
STORAGE_BUCKET=launch-backups
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Email
MAIL_DRIVER=resend
RESEND_API_KEY=
MAIL_FROM_NAME=Launch
MAIL_FROM_ADDRESS=hello@launchctl.io
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Slack Notifications
SLACK_WEBHOOK_URL=

# GitHub App Configuration (only needed if you're touching the source-
# control integrations locally; otherwise leave blank).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Sentry Error Tracking (only enabled in production by default)
SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_DEBUG=false
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.1

# Billing (Dodo Payments)
BILLING_SUBSCRIPTIONS_ENABLED=false
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_TEST_MODE=true
