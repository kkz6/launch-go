# Application
APP_NAME=launchctl
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database
# Option 1: Use a connection URL (takes priority over individual fields)
# DB_URL=mysql://root:password@tcp(localhost:3306)/launch?charset=utf8mb4&parseTime=True&loc=Local
# DB_URL=postgres://root:password@localhost:5432/launch?sslmode=disable

# Option 2: Use individual fields
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=launch
DB_USERNAME=root
DB_PASSWORD=

# Redis (for queues)
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=72

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Queue
QUEUE_CONCURRENCY=10

# SSH
SSH_KEY_PATH=~/.ssh
SSH_DEFAULT_USER=root

# Storage (S3)
STORAGE_DRIVER=s3
STORAGE_BUCKET=launch-backups
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Email
MAIL_DRIVER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Launch
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Slack Notifications
SLACK_WEBHOOK_URL=

# Sentry Error Tracking (only enabled in production by default)
SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_DEBUG=false
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.1

# Billing (Dodo Payments)
BILLING_SUBSCRIPTIONS_ENABLED=false
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_TEST_MODE=true
