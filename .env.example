# Application
APP_NAME=Launch
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=launch
DB_USERNAME=root
DB_PASSWORD=

# Redis (for queues)
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=72

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Queue
QUEUE_CONCURRENCY=10

# SSH
SSH_KEY_PATH=~/.ssh
SSH_DEFAULT_USER=root

# Storage (S3)
STORAGE_DRIVER=s3
STORAGE_BUCKET=launch-backups
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Email
MAIL_DRIVER=resend
RESEND_API_KEY=

# Slack Notifications
SLACK_WEBHOOK_URL=
