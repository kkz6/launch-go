#!/bin/bash
set -euo pipefail
trap '' PIPE
export DEBIAN_FRONTEND=noninteractive


sudo mysql --user="root" --password="rootpassword" -e "CREATE USER IF NOT EXISTS 'appuser'@'%' IDENTIFIED BY 'apppassword';"

sudo mysql --user="root" --password="rootpassword" -e "CREATE USER IF NOT EXISTS 'appuser'@'localhost' IDENTIFIED BY 'apppassword';"

